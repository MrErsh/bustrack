<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BusTrack.App.ViewModels"
             x:Class="BusTrack.App.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Настройки">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Маршрут" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding RouteItems}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedRouteItem}"
                    Title="Выберите маршрут" />

            <Label Text="Направление" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding DirectionItems}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedDirectionItem}"
                    Title="Выберите направление" />

            <Label Text="Остановка для уведомления" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding StopItems}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedStopItem}"
                    Title="Выберите остановку" />

            <Label Text="Уведомить за (минут до прибытия)" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Minutes}"
                    SelectedItem="{Binding SelectedMinutes}" />

            <Label Text="{Binding Error}"
                   TextColor="{StaticResource Magenta}"
                   IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />

            <Button Text="Сохранить" Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>